<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<title>EJS | Notes App</title>
</head>

<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10 text-white">
            <form action="/create" method="post">
                <input class="block px-5 py-2 bg-zinc-800 mt-2 w-full" type="text" placeholder="title" name="title">
                <textarea class="block px-5 py-2 bg-zinc-800 resize-none mt-2 w-full" name="details" id=""
                    placeholder="task details"></textarea>
                <input type="submit" name="" id="" value="create task" class="mt-2 bg-blue-600 px-4 py-2">
            </form>
        </div>
        <div class="tasks p-10 flex gap-4 flex-wrap">
            <% if (files.length>0) { %>
                <%files.forEach((value)=>{ %>
                    <div class="task  w-72 px-3 py-4 bg-zinc-800">
                        <h1 class="text-white tracking-tighter text-3xl">
                            <%=value%>
                        </h1>
                        <a href='/file/<%= value  %>' class="inline-block text-blue-500 mt-3">read more</a>
                    </div>
                    <% })%>
                        <% } else {%>
                            <h3 class="text-2xl text-zinc-500">No Tasks Yet</h3>
                            <% } %>
        </div>
    </div>
</body>

</html>