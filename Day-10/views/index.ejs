<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Server Side Rendering Of Users</title>
</head>

<body class="bg-zinc-900 w-full h-full ">
    <div class="py-10 text-white">
        <form action="/create" method="post">
            <input type="text" placeholder="name" name="name"
                class="outline-none py-3 text-zinc-300 rounded-lg px-2  border-2 border-zinc-800">
            <input type="text" placeholder="email" name="email "
                class="outline-none py-3 text-zinc-300 rounded-lg px-2 border-2 border-zinc-800">
            <input type="text" placeholder="Image Url" name="image"
                class="outline-none py-3 text-zinc-300 rounded-lg px-2 border-2 border-zinc-800">
            <input type="submit" value="Create User" class="text-white bg-blue-500  px-2 py-3 rounded-lg ">
        </form>
    </div>
</body>

</html>