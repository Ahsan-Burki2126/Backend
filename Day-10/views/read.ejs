<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Cards</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-800">
    <div class="max-w-6xl mx-auto p-6">
        <a href="/" class="text-blue-600">GO HOME</a>

        <h1 class="text-3xl font-bold mb-6">All Users</h1>
        <div class="users flex gap-6 flex-wrap">
            <% if (users && users.length> 0) { %>
                <% users.forEach(user=> { %>
                    <div
                        class="userCard bg-white rounded-xl shadow-md w-72 p-5 hover:shadow-xl transition-all duration-300">
                        <div class="flex flex-col items-center text-center">
                            <img src="<%= user.image %>" alt="User Image"
                                class="w-24 h-24 rounded-full shadow mb-4 object-cover" />
                            <h3 class="text-xl font-semibold mb-1">
                                <%= user.name %>
                            </h3>
                            <h5 class="text-gray-500 text-sm mb-4">
                                <%= user.email %>
                            </h5>
                        </div>

                        <div class="flex justify-between mt-4 w-full">
                            <button
                                class="bg-blue-500 text-white px-4 py-1 rounded hover:bg-blue-600 text-sm">Edit</button>
                            <a href="/delete/<%= user._id %>"
                                class="bg-red-500 text-white px-4 py-1 rounded hover:bg-red-600 text-sm">Delete</a>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <h1 class="text-xl text-red-500">No Users Found</h1>
                            <% } %>
        </div>
    </div>
</body>

</html>